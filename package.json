{
  "name": "@mfr/chat",
  "version": "0.1.0",
  "description": "Runtime-agnostic core for a site chat assistant: provider adapters, agent loop, session tokens, validation and SSE, behind ports for storage, rate limiting and human verification.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./metadata": {
      "types": "./dist/core/providers/metadata.d.ts",
      "default": "./dist/core/providers/metadata.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "openai": "^7.8.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}
